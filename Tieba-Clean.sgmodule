#!name=百度贴吧去广告
#!desc=移除开屏、信息流和帖内广告，精简侧拉抽屉及我的页面。需要 Surge iOS 5.14.0+ 或 Mac 5.9.0+；启用重写、脚本和 MitM，并安装信任 MitM 证书。
#!arguments=per_filter_video_thread:true
#!arguments-desc=per_filter_video_thread：true 拦截首页推荐视频帖，false 保留。默认沿用原规则的首选项 true。
# 原规则作者：可莉 https://github.com/luestr/ProxyResource 、app2smile https://github.com/app2smile
# 转换日期：2026-11-04。保留原规则的匹配范围及远程 ProtoBuf 脚本。
# Surge JSON 重写文档：https://manual.nssurge.com/http/body-rewrite.html

[Rule]
DOMAIN,180.76.76.200,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[Map Local]
(?i)^https?://tiebac\.baidu\.com/c/f/forum/getInterestClassList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https?://tiebac\.baidu\.com/c/f/search/discover$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https?://tieba\.baidu\.com/mo/q/search/startPage\? data-type=base64 data="eyJubyI6MCwiZXJyb3IiOiJzdWNjZXNzIn0=" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https?://tieba\.baidu\.com/c/f/search/discover$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https://tieba\.baidu\.com/c/f/forum/getForumAlbum$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^http://c\.tieba\.baidu\.com/c/f/forum/hotforum$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"

[Body Rewrite]
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/s/sync$ 'del(.activity_switch, .video_report_config, .advertisement_config, .next_start, .push_strategy_new, .live_activity_guide, .h5_pop_ups, .duxiaoman_url, .is_need_remind_live_rooms, .floating_icon, .ad_stlog_switch, .first_time_motivate, .windowStrategyList, .ad_adsense, .ad_config, .videoup_guide_pop, .ad_origin_config_switch, .needNewUserLead, .h5_pop_ups_config, .alaTabColor, .search_guide, .ad_sdk_priority, .low_version_pop_config, .ad_num_competition_frs, .live_new_user_guide_day, .screen_fill_data_result, .yy_live_tab, .ad_num_competition_personalize, .complete_apk_url, .user_activity, .homepage_guide, .bottom_bubble_config, .home_screen_ad, .afSearch_tab, .recent_client_info, .video_activity, .namoaixud_url, .yy_live_config, .user_growth_task_list, .cloud_control_data_info, .wl_config.pb_banner_funad_cache_strategy, .wl_config.pb_comment_asyncafd_cache_strategy, .wl_config.download_edge_float, .wl_config.download_pause_retain_dialog_conf, .wl_config.download_mobile_dialog_conf, .wl_config.download_fake_progress_config_a, .wl_config.download_fake_progress_config_b, .scheme_whitelist)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/s/sync$ '.wl_config.home_ad_num = 0 | .wl_config.frs_ad_num = 0 | .wl_config.pb_comment_ad_num = 0 | .wl_config.index_bear_density = 0 | .wl_config.frs_bear_density = 0 | .wl_config.index_bear_first_floor_max = 999999999 | .wl_config.index_bear_first_floor_min = 999999999'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/s/sync$ '.index_tab_info |= map(select(.tab_name == "推荐")) | .top_level_navi |= {"推荐": .["推荐"], "侧边栏": .["侧边栏"], "关注": .["关注"]}'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/u/user/profile$ 'del(.url_map, .user_agent_info, .bubble_info, .duxiaoman_entry, .uc_card, .finance_tab, .vip_banner, .ala_live_info, .recom_naws_list, .duxiaoman, .user.consume_info, .namoaixud_entry)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/u/user/profile$ '.user.shake_ad_switch.is_show = 0'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/u/user/profile$ '.custom_grid |= map(select(.title != "游戏大厅" and .title != "预约管理" and .title != "领话费" and .title != "短故事")) | .zone_info |= map(.common_func |= (if .common_func_noraml then .common_func_noraml |= map(select(.name != "创建智能体")) else . end)) | .zone_info |= map(select(.type != "commerce" and .type != "banner" and .type != "game"))'
http-response-jq (?i)^https?://tieba\.baidu\.com/c/f/forum/forumGuide$ 'del(.hot_search)'
http-response-jq (?i)^https?://tieba\.baidu\.com/c/f/frs/frsBottom\? 'del(.card_activity)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/f/frs/frsBottom$ 'del(.card_activity)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/f/sidebar/home$ 'del(.game_center, .tools, .task_list, .vip_banner)'

[Script]
Tieba-Proto = type=http-response, pattern=(?i)^https?://tieba(?:c)?\.baidu\.com/c/(f/excellent/personalized|f/frs/page|b/ad/adBid|f/ad/getFeedAd|f/pb/page|f/frs/generalTabList)\?cmd=\d+&format=protobuf, script-path=https://raw.githubusercontent.com/fkingikelee/fkikelee/main/Resource/kelee/JavaScript/Tieba/tieba-proto.js, timeout=10, requires-body=true, binary-body-mode=true, argument="per_filter_video_thread={{{per_filter_video_thread}}}"

[MITM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
